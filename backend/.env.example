# ColdTrace Backend Environment Configuration

# Server Port (Render sets this automatically to 10000; defaults to 8000 locally)
PORT=8000

# Environment mode ('development' enables auto-reload; 'production' optimizes for cloud hosting)
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated domains, or '*' for unrestricted prototype access)
# Examples:
# CORS_ORIGINS=https://coldtrace.onrender.com,https://coldtrace-frontend.vercel.app
CORS_ORIGINS=*

# Database Connection URL:
# 1. Ephemeral / Local SQLite (default when unset):
# DATABASE_URL=sqlite:///./coldtrace.db

# 2. Hosted PostgreSQL (Render PostgreSQL, Neon, or Supabase):
# DATABASE_URL=postgresql://user:password@hostname:5432/coldtrace_db
